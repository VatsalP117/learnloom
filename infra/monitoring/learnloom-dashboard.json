{
  "title": "Learnloom operations and learning economics",
  "uid": "learnloom-operations",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Oldest queue age",
      "targets": [
        { "expr": "learnloom_queue_oldest_issue_seconds", "legendFormat": "issue" },
        { "expr": "learnloom_queue_oldest_delivery_seconds", "legendFormat": "delivery" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Postgres pool saturation",
      "targets": [
        { "expr": "learnloom:database_pool_saturation", "legendFormat": "acquired / max" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Estimated spend today (USD)",
      "targets": [
        { "expr": "learnloom_model_estimated_cost_today_microusd / 1000000" }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 }
    },
    {
      "type": "stat",
      "title": "Cost / completed lesson (USD)",
      "targets": [
        { "expr": "learnloom:model_cost_per_completed_microusd / 1000000" }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 }
    },
    {
      "type": "stat",
      "title": "Cost / retained learner (USD)",
      "targets": [
        { "expr": "learnloom:model_cost_per_retained_learner_microusd / 1000000" }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 8 }
    },
    {
      "type": "timeseries",
      "title": "Provider retries",
      "targets": [
        { "expr": "learnloom_model_provider_retries", "legendFormat": "cumulative" }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 8 }
    }
  ]
}
