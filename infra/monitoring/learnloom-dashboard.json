{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "$prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [{ "expr": "up{job=\"learnloom\",service=\"web\"}", "refId": "A" }],
      "title": "Web metrics target",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [{ "expr": "up{job=\"learnloom\",service=\"worker\"}", "refId": "A" }],
      "title": "Worker metrics target",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$prometheus" },
      "fieldConfig": { "defaults": { "decimals": 2, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [{ "expr": "sum(rate(learnloom_http_request_duration_seconds_count{status=\"5xx\"}[5m])) / clamp_min(sum(rate(learnloom_http_request_duration_seconds_count[5m])), 0.001)", "refId": "A" }],
      "title": "HTTP 5xx ratio",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$prometheus" },
      "fieldConfig": { "defaults": { "decimals": 2, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(learnloom_http_request_duration_seconds_bucket[5m])))", "refId": "A" }],
      "title": "Overall HTTP p95",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 5,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [{ "expr": "learnloom_queue_issues", "refId": "A" }],
      "title": "Queued issues",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$prometheus" },
      "fieldConfig": { "defaults": { "decimals": 2, "unit": "currencyUSD" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 6,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [{ "expr": "learnloom_model_estimated_cost_today_microusd / 1000000", "refId": "A" }],
      "title": "Model spend today",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 7,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum by (route) (rate(learnloom_http_request_duration_seconds_count[5m]))", "legendFormat": "{{route}}", "refId": "A" }],
      "title": "Request rate by route",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 8,
      "options": { "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, route) (rate(learnloom_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}", "refId": "A" }],
      "title": "HTTP p95 latency by route",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 9,
      "options": { "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(learnloom_worker_operation_duration_seconds_bucket[30m])))", "legendFormat": "{{operation}}", "refId": "A" }],
      "title": "Worker operation p95 duration",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 10,
      "options": { "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum by (operation, outcome) (increase(learnloom_worker_operation_duration_seconds_count[1h]))", "legendFormat": "{{operation}} · {{outcome}}", "refId": "A" }],
      "title": "Worker operation outcomes (1h)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 20 },
      "id": 11,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "learnloom_queue_oldest_issue_seconds", "legendFormat": "issue", "refId": "A" },
        { "expr": "learnloom_queue_oldest_delivery_seconds", "legendFormat": "delivery", "refId": "B" }
      ],
      "title": "Oldest queue item",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 20 },
      "id": 12,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "learnloom_active_issues", "legendFormat": "issues", "refId": "A" },
        { "expr": "learnloom_active_deliveries", "legendFormat": "deliveries", "refId": "B" }
      ],
      "title": "Active worker operations",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$prometheus" },
      "fieldConfig": { "defaults": { "max": 1, "min": 0, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 20 },
      "id": 13,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [{ "expr": "learnloom_database_connections{state=\"acquired\"} / clamp_min(learnloom_database_connection_limit, 1)", "legendFormat": "pool saturation", "refId": "A" }],
      "title": "Postgres pool saturation",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$prometheus" },
      "fieldConfig": { "defaults": { "max": 1, "min": 0, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 27 },
      "id": 14,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [{ "expr": "1 - avg(rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[5m]))", "legendFormat": "CPU used", "refId": "A" }],
      "title": "VM CPU utilization",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$prometheus" },
      "fieldConfig": { "defaults": { "max": 1, "min": 0, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 27 },
      "id": 15,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [{ "expr": "1 - node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"}", "legendFormat": "memory used", "refId": "A" }],
      "title": "VM memory utilization",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$prometheus" },
      "fieldConfig": { "defaults": { "max": 1, "min": 0, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 27 },
      "id": 16,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [{ "expr": "1 - node_filesystem_avail_bytes{job=\"node\",mountpoint=\"/\",fstype!=\"rootfs\"} / node_filesystem_size_bytes{job=\"node\",mountpoint=\"/\",fstype!=\"rootfs\"}", "legendFormat": "disk used", "refId": "A" }],
      "title": "VM root disk utilization",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "id": 17,
      "options": { "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum by (container_label_com_learnloom_service) (rate(container_cpu_usage_seconds_total{job=\"docker\"}[5m]))", "legendFormat": "{{container_label_com_learnloom_service}}", "refId": "A" }],
      "title": "Container CPU cores used",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
      "id": 18,
      "options": { "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum by (container_label_com_learnloom_service) (container_memory_working_set_bytes{job=\"docker\"})", "legendFormat": "{{container_label_com_learnloom_service}}", "refId": "A" }],
      "title": "Container working-set memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "$loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 42 },
      "id": 19,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "datasource": { "type": "loki", "uid": "$loki" }, "editorMode": "code", "expr": "{project=\"learnloom\"}", "queryType": "range", "refId": "A" }],
      "title": "Learnloom container logs",
      "type": "logs"
    }
  ],
