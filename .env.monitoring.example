# Copy these values from Grafana Cloud -> Connections -> Add new connection.
# The metrics and logs usernames are numeric stack IDs and may be different.
GRAFANA_CLOUD_METRICS_URL=https://prometheus-prod-XX-XXX.grafana.net/api/prom/push
GRAFANA_CLOUD_METRICS_USER=replace-with-metrics-user-id
GRAFANA_CLOUD_LOGS_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOGS_USER=replace-with-logs-user-id

# Use a stack-scoped access-policy token with metrics:write and logs:write only.
GRAFANA_CLOUD_TOKEN=glc_replace_me

# Stable label used to distinguish this VM from future hosts.
MONITORING_HOST=learnloom-production-1
